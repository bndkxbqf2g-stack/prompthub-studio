# Runtime
NODE_ENV=development
PROMPTHUB_MODE=memory
AUTH_MODE=local
PROMPTHUB_HOST=127.0.0.1
PROMPTHUB_PORT=8787
PROMPTHUB_PUBLIC_ORIGIN=http://127.0.0.1:8787
SESSION_SECRET=development-only-change-me-please-1234567890

# GitHub control plane (required when PROMPTHUB_MODE=github)
GITHUB_API_URL=https://api.github.com
GITHUB_TOKEN=
GITHUB_REPOSITORY=owner/private-control-repo
GITHUB_BRANCH=main
GITHUB_REQUIRE_PRIVATE=true
GITHUB_ALLOWED_LOGINS=

# GitHub OAuth (required when AUTH_MODE=github)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_OAUTH_SCOPES=read:user

# Runner
PROMPTHUB_RUNNER_ID=mac-runner-local
PROMPTHUB_PROJECT_ROOT=
PROMPTHUB_ALLOWED_PROJECTS=demo
PROMPTHUB_PROJECT_PATHS_JSON={}
PROMPTHUB_LEASE_PATH=.prompthub/active-jobs.json
PROMPTHUB_LEASE_TTL_MS=120000
PROMPTHUB_HEARTBEAT_MS=30000
PROMPTHUB_POLL_MS=10000
CODEX_EXECUTABLE=
CODEX_ARGS_JSON=["exec","--","$PROMPTHUB_PROMPT"]
